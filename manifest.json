{
  "name": "The Bridge — Wayne Estate",
  "short_name": "The Bridge",
  "description": "Command the estate, not your inbox.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f4eee1",
  "theme_color": "#1a140d",
  "icons": [
    {
      "src": "icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "media",
          "accept": [
            "image/*",
            "audio/*",
            ".opus",
            ".ogg",
            ".oga",
            ".m4a",
            ".mp3",
            ".aac",
            ".wav",
            ".amr"
          ]
        }
      ]
    }
  }
}
